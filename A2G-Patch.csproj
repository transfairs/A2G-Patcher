<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Windows 2000 build (msbuild /p:Win2000=true): same sources, built against .NET Framework 2.0 SP2,
       the last framework Windows 2000 runs. Own obj folder, because the NuGet restore result depends on
       the target framework and would otherwise flip back and forth between both builds. -->
  <PropertyGroup Condition="'$(Win2000)' == 'true'">
    <BaseIntermediateOutputPath>obj\Win2000\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{3B7D2E4A-9C15-4F6E-8A21-5D0C7E9B1F36}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>A2GPatch</RootNamespace>
    <AssemblyName>A2G-Patch</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <!-- Client Profile: what Windows XP machines usually got via Windows Update; runs on the full framework too. -->
    <TargetFrameworkProfile>Client</TargetFrameworkProfile>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>A2G-Patch.ico</ApplicationIcon>
    <!-- asInvoker: with a manifest, Windows doesn't virtualize writes to Program Files, so missing
         rights show up as such and the program can offer to restart as administrator. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <!-- Only exists from .NET 3.5 on. -->
  <ItemGroup Condition="'$(Win2000)' != 'true'">
    <Reference Include="System.Core" />
  </ItemGroup>
  <!-- Windows 2000 build: .NET 2.0 SP2 target plus replacements for what 2.0 lacks (Compat\). -->
  <PropertyGroup Condition="'$(Win2000)' == 'true'">
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <TargetFrameworkProfile></TargetFrameworkProfile>
    <DefineConstants>$(DefineConstants);WIN2000</DefineConstants>
    <OutputPath>bin\Win2000\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Win2000)' == 'true'">
    <Compile Include="Compat\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AboutDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="BusyIndicator.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="GameInstall.cs" />
    <Compile Include="GameTexts.cs" />
    <Compile Include="GroupList.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="GogPatches.cs" />
    <Compile Include="ManagerCode.cs" />
    <Compile Include="NetworkPlay.cs" />
    <Compile Include="Patches.cs" />
    <Compile Include="PatchTile.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="PatchForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\VersionInfo.cs" />
    <Compile Include="TextPatches.cs" />
    <Compile Include="Theme.cs" />
    <Compile Include="V101Code.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The logo for the about dialog, which wants its 64 px frame (the exe icon only yields 32 px). -->
    <EmbeddedResource Include="A2G-Patch.ico">
      <LogicalName>A2GPatch.Logo.ico</LogicalName>
    </EmbeddedResource>
    <!-- Built by dll\build.cmd (not committed); without it the exe can only patch exes on disk. -->
    <EmbeddedResource Include="dll\msvfw32.dll" Condition="Exists('dll\msvfw32.dll')">
      <LogicalName>A2GPatch.msvfw32.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
